# ============================================================
# Konfigurasi environment SaringSini
# ============================================================
# Pengembangan lokal:
#   cp .env.example .env            (Linux/macOS)
#   copy .env.example .env          (Windows)
# `npm start` dan `npm run dev` memuat .env otomatis (flag --env-file Node.js).
# Variabel yang sudah ada di environment lebih diutamakan daripada isi .env.
# ============================================================

# --- Diperlukan untuk fitur AI ---

# Google AI Studio API Key (gratis di https://aistudio.google.com/).
# Tanpa ini server tetap berjalan, tetapi endpoint AI mengembalikan 503.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Opsional ---

# Port HTTP (Cloud Run mengaturnya otomatis)
PORT=3000

# development | production
# production menyembunyikan detail error, mengaktifkan HSTS dan cache aset statis.
NODE_ENV=development

# ID model Gemini dan batas waktu permintaan (milidetik)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_MS=30000

# Jumlah reverse proxy di depan aplikasi. Isi 1 di Cloud Run agar rate limit per-IP
# membaca alamat klien yang sebenarnya. Biarkan kosong bila aplikasi diakses langsung:
# jika tidak, klien dapat memalsukan header X-Forwarded-For. Nilai "true" ditolak.
# TRUST_PROXY=1

# Folder penyimpanan community.json (penyimpanan lokal untuk dev/demo)
# DATA_DIR=./data

# Tampilkan potongan pesan yang sudah diperiksa (nomor/email disamarkan) di feed komunitas.
# Isi false untuk menonaktifkan.
# COMMUNITY_AUTO_PUBLISH=true

# Batas permintaan per IP per menit
# RATE_LIMIT_AI_PER_MINUTE=6
# RATE_LIMIT_WRITE_PER_MINUTE=20
# RATE_LIMIT_API_PER_MINUTE=120
