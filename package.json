{
  "name": "saringsini",
  "version": "2.3.0",
  "description": "Asisten Filter Hoaks dan Generator Balasan Sopan Grup Keluarga WhatsApp - JuaraVibeCoding 2026",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start:prod": "node --env-file-if-exists=.env -e \"process.env.NODE_ENV='production';require('./src/server.js')\"",
    "health": "node -e \"fetch('http://localhost:3000/api/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2)))\"",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "hoax-detector",
    "gemini-ai",
    "indonesian",
    "whatsapp-reply",
    "vibecoding",
    "pwa",
    "deepfake-detection",
    "phishing-checker"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "Sultan & Misha",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
